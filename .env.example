# Which model provider to use: "fake" (deterministic, offline) or "anthropic"
LLM_PROVIDER=fake

# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Model routing. The "fast" model handles guardrail classification and cheap steps;
# the "primary" model handles investigation reasoning.
LLM_MODEL_PRIMARY=claude-sonnet-4-20250514
LLM_MODEL_FAST=claude-3-5-haiku-20241022

# Cost controls (USD)
COST_MAX_PER_REQUEST_USD=0.25
COST_DAILY_BUDGET_USD=50

# Agent loop limits
AGENT_MAX_TURNS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_MS=30000

# HTTP
PORT=8080
LOG_LEVEL=info
